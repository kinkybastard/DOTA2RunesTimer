<Controls:MetroWindow x:Class="DOTA2RunesTimer.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:helpers="clr-namespace:DOTA2RunesTimer.HELPERS"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      mc:Ignorable="d"
        
        Title="RunesTimer"
        Height="100" MinHeight="100" MaxHeight="100"
        Width="385" MinWidth="350" MaxWidth="385"
        
        Topmost="True"
        Background="Transparent"
        WindowStyle="ToolWindow"
        BorderThickness="1"
        NonActiveBorderBrush="SaddleBrown"
        ShowTitleBar="False"
        TitleBarHeight="20"
        ResizeMode="CanResize"
        ShowMaxRestoreButton="False">
    
    <Window.Resources>
        <FontFamily x:Key="Dota2Font" />
        
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/MEDIA/TRAJAN PRO FONTS/#Trajan Pro" />
        </Style>

        <helpers:ColorConverter x:Key="ColorConverter"/>
    </Window.Resources>


    <!-- ОКНО -->
    <Grid MouseDown="Grid_MouseDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- КНОПКИ -->
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" Margin="7,0,0,0">
            <Button x:Name="BUStart"
                    Margin="5"
                    Height="20"
                    Width="55"
                    Style="{DynamicResource MahApps.Styles.Button.MetroWindow.Base}"
                    Command="{Binding StartPauseCommand}"
                
                    Content="{Binding StartOrPause, Mode=OneWay}"
                    FontFamily="pack://application:,,,/MEDIA/TRAJAN PRO FONTS/#Trajan Pro"/>

            <Button x:Name="BUReset"
                    Margin="5"
                    Height="20"
                    Width="55"
                    Style="{DynamicResource MahApps.Styles.Button.MetroWindow.Base}"
                    Command="{Binding ResetCommand}"
                
                    Content="RESET"
                    FontFamily="pack://application:,,,/MEDIA/TRAJAN PRO FONTS/#Trajan Pro"/>
        </StackPanel>

        <!-- ТЕКСТ -->
        <Grid Grid.Column="0" Grid.RowSpan="2" Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="30"/>
                <RowDefinition MinHeight="30"/>
                <RowDefinition MinHeight="30"/>
            </Grid.RowDefinitions>

            <!-- ИГРОВОЕ ВРЕМЯ -->
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="In-game Time: " Foreground="Gray"/>
            <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding InGameTimeString, Mode=OneWay}" Foreground="Gray"/>
            
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,7">
                <Button x:Name="BUAddSecond"
                        Margin="0,0,15,0"
                        Command="{Binding AddSecondCommand}"
                        Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                        Content="+" Width="25" Height="25" VerticalContentAlignment="Center" FontSize="18">

                </Button>

                <Button x:Name="BURemoveSecond"
                        Command="{Binding RemoveSecondCommand}"
                        Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                        Content="-" Width="25" Height="25" VerticalContentAlignment="Center" FontSize="18">
                </Button>
            </StackPanel>

            <!-- ТЕКУЩЕЕ СОБЫТИЕ -->
            <RichTextBox Margin="-7,0,0,0" Background="Transparent" IsReadOnly="True" helpers:RichTextHelper.FormattedText="{Binding CurrentEvent}" Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Center" FontSize="16" BorderThickness="0" FontFamily="Dota2Fonts"/>
            <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="Transparent" Cursor="Arrow"/>
            
            <!-- СЛЕДУЮЩЕЕ СОБЫТИЕ -->
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center" FontSize="12"  Foreground="Gray">
                <Run Text="{Binding NextEvent, Mode=OneWay}"/>
                <Run Text="     "/>
                <Run Text="{Binding CountdownString, Mode=OneWay}"/>
            </TextBlock>
        </Grid>

        <!-- ПЛАШКА С ПАУЗОЙ -->
        <Rectangle x:Name="BannerPause" Grid.ColumnSpan="1" Grid.RowSpan="3" Fill="Black" Visibility="Collapsed"/>
        <TextBlock x:Name="TextPause" Grid.ColumnSpan="1" Grid.RowSpan="3" Text="PAUSE" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        
        <!-- ИГРОВОЙ РЕЖИМ -->
        <Rectangle x:Name="BannerGameMode" Grid.ColumnSpan="2" Grid.RowSpan="3" Fill="Black" Visibility="Visible"/>
        <TextBlock x:Name="TBGamemode" Grid.ColumnSpan="2" Grid.RowSpan="2" Text="Select Gamemode" FontSize="18" HorizontalAlignment="Center" Visibility="Visible" Foreground="White" Margin="15"/>
        <Button x:Name="BUTurbo" Grid.ColumnSpan="2" Command="{Binding TurboModeCommand}" Visibility="Visible" Grid.RowSpan="2" Height="25" Width="100" HorizontalAlignment="Left" Margin="60,40,0,0" BorderThickness="0" Content="TURBO" FontFamily="pack://application:,,,/MEDIA/TRAJAN PRO FONTS/#Trajan Pro" Style="{DynamicResource MahApps.Styles.Button.MetroWindow.Base}"/>
        <Button x:Name="BUAllPick" Grid.ColumnSpan="2" Command="{Binding AllPickModeCommand}" Visibility="Visible" Grid.RowSpan="2" Height="25" Width="100" HorizontalAlignment="Right" Margin="0,40,60,0" BorderThickness="0" Content="ALLPICK" FontFamily="pack://application:,,,/MEDIA/TRAJAN PRO FONTS/#Trajan Pro" BorderBrush="AliceBlue" Style="{DynamicResource MahApps.Styles.Button.MetroWindow.Base}"/>
    
    </Grid>
</Controls:MetroWindow>
